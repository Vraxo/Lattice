@namespace Lattice.Desktop
@using Lattice.Core
@using Lattice.CSharp
@inject DesktopSession Session

<main class="chat-shell">
    <header class="topbar">
        <div class="identity">
            <div class="brand-row">
                <h1 class="brand">Lattice</h1>
                <span class="badge">SYMBOLIC · READ-ONLY</span>
            </div>
            <span class="subtitle">Evidence-grounded workspace conversation</span>
        </div>

        <div class="workspace-controls">
            <div class="workspace-indicator" id="active-workspace" data-connected="@(Session.IsConnected ? "true" : "false")">
                <span class="status-dot" aria-hidden="true"></span>
                <span class="indicator-label">Workspace</span>
                @if (Session.IsConnected)
                {
                    <code class="indicator-path" title="@Session.ConnectedWorkspacePath">@Session.ConnectedWorkspacePath</code>
                }
                else
                {
                    <span class="indicator-empty">Not connected</span>
                }
            </div>

            <form id="workspace-form" class="workspace-form" @onsubmit="() => Session.ConnectAsync()" @onsubmit:preventDefault>
                <fieldset disabled="@Session.IsBusy" class="workspace-fieldset">
                    <label for="workspace-path" class="sr-only">Local workspace folder path</label>
                    <div class="workspace-input-group">
                        <input
                            id="workspace-path"
                            type="text"
                            @bind="Session.WorkspacePathInput"
                            @bind:event="oninput"
                            placeholder="Local folder path…"
                            autocomplete="off" />
                        <button id="connect-workspace" type="submit" class="secondary">
                            @(Session.IsConnecting ? "Connecting…" : "Connect")
                        </button>
                    </div>
                </fieldset>
            </form>
        </div>
    </header>

    @if (Session.WorkspaceError is not null)
    {
        <div class="workspace-banner">
            <p id="workspace-error" class="alert error" data-error-kind="InvalidWorkspace" role="alert">@Session.WorkspaceError</p>
        </div>
    }

    <section
        id="conversation-transcript"
        class="conversation-stage"
        role="log"
        aria-live="polite"
        aria-relevant="additions"
        aria-label="Workspace conversation">
        @if (Session.Entries.Count == 0 && !Session.IsSubmitting)
        {
            <div id="chat-empty-state" class="chat-empty-state">
                @if (Session.IsConnected)
                {
                    <h2 class="empty-title">Ask about your codebase</h2>
                    <p class="empty-description">
                        Connected to <code>@Session.ConnectedWorkspacePath</code> in read-only mode.
                        Ask Lattice to open files, search source text, or inspect C# types and members.
                    </p>
                    <ul class="example-list" aria-label="Example questions">
                        <li>“Where is WorkspaceRoot used in this project?”</li>
                        <li>“Where is WorkspaceRoot defined?”</li>
                        <li>“Show me the members of WorkspaceRoot.”</li>
                        <li>“Show me Program.cs.”</li>
                    </ul>
                    <p class="empty-footnote">
                        Source search matches literal text. C# structure inspection reads syntax declarations; project compilation and reference resolution are not included yet.
                    </p>
                }
                else
                {
                    <h2 class="empty-title">Connect a workspace folder to begin</h2>
                    <p class="empty-description">
                        Enter an existing local folder path in the header bar above and select <strong>Connect</strong>.
                        Once connected, you can ask about files, literal source-text occurrences, and C# declaration structure in that directory.
                    </p>
                    <ul class="example-list" aria-label="Example questions">
                        <li>“Where does WorkspaceRoot appear?”</li>
                        <li>“Where is WorkspaceRoot defined?”</li>
                        <li>“Open the file README.md.”</li>
                    </ul>
                    <p class="empty-footnote">
                        All workspace access stays read-only and confined to the connected folder.
                    </p>
                }
            </div>
        }
        else
        {
            <ol id="turn-history" class="chat-thread">
                @foreach (DesktopTurnEntry entry in Session.Entries)
                {
                    <li class="chat-exchange @GetExchangeClass(entry.Kind)" data-turn-kind="@entry.Kind">
                        <article class="chat-message user-message" data-message-role="user" aria-label="Your message">
                            <div class="message-header">
                                <span class="message-author">You</span>
                            </div>
                            <p class="message-body user-body">@entry.RequestText</p>
                        </article>

                        <article
                            class="chat-message assistant-message @GetAssistantClass(entry.Kind)"
                            data-message-role="assistant"
                            aria-label="Lattice response">
                            <div class="message-header">
                                <span class="message-author">Lattice</span>
                                @if (entry.WorkspacePath is not null)
                                {
                                    <code class="turn-workspace">@entry.WorkspacePath</code>
                                }
                            </div>

                            <p class="message-body assistant-body turn-summary">@(entry.LeadSummary ?? entry.Summary)</p>

                            @if (!entry.SafeCandidatePaths.IsEmpty)
                            {
                                <div class="candidate-box">
                                    <ol class="candidate-list" tabindex="0" aria-label="Matching workspace files">
                                        @foreach (string candidatePath in entry.SafeCandidatePaths)
                                        {
                                            <li class="candidate-item" data-candidate-path="@candidatePath">
                                                <code class="candidate-path">@candidatePath</code>
                                            </li>
                                        }
                                    </ol>
                                    @if (entry.OmittedCandidateCount > 0 || entry.HasMoreCandidates)
                                    {
                                        <div class="candidate-omitted-note">
                                            @FormatOmittedCandidates(entry.OmittedCandidateCount, entry.HasMoreCandidates)
                                        </div>
                                    }
                                </div>
                            }

                            @if (entry.Kind == DesktopTurnKind.FileInspected && entry.FileContents is not null)
                            {
                                <div class="file-viewer">
                                    <div class="file-viewer-header">
                                        <code class="file-path">@entry.InspectedRelativePath</code>
                                        <span class="file-meta">@FormatLines(entry.LineCount) · Read-only</span>
                                    </div>
                                    <pre class="file-contents" tabindex="0" aria-label="Contents of @entry.InspectedRelativePath"><code>@entry.FileContents</code></pre>
                                </div>
                            }
                            else if (entry.Kind == DesktopTurnKind.SearchResults)
                            {
                                <div class="evidence-box">
                                    <div class="search-mode-note">
                                        Literal source-text matches (case-insensitive; not semantic declarations or references)
                                    </div>
                                    <ul class="evidence-list" tabindex="0" aria-label="Matching workspace locations">
                                        @foreach (EvidenceReference reference in entry.SafeEvidence)
                                        {
                                            <li class="evidence-item" data-evidence-path="@reference.RelativePath" data-evidence-line="@reference.StartLine">
                                                <code class="evidence-location">@reference.RelativePath:@reference.StartLine</code>
                                                <code class="evidence-snippet">@reference.Snippet</code>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                            else if (entry.Kind == DesktopTurnKind.CSharpStructureResults)
                            {
                                <section class="structure-box" aria-label="C# declarations">
                                    <div class="structure-header">
                                        <span>Roslyn syntax declarations</span>
                                        <span>@(entry.StructureSourceFileCount ?? 0) source files inspected</span>
                                    </div>
                                    @if (entry.SafeDeclarations.IsEmpty)
                                    {
                                        <p class="structure-empty">No matching C# declarations were found.</p>
                                    }
                                    else
                                    {
                                        <ol class="structure-list" tabindex="0">
                                            @foreach (CSharpDeclaration declaration in entry.SafeDeclarations)
                                            {
                                                <li class="structure-item" data-declaration-name="@declaration.Name">
                                                    <div class="structure-meta">
                                                        <span class="structure-kind">@declaration.Kind</span>
                                                        <code class="structure-location">@declaration.RelativePath:@declaration.Line</code>
                                                    </div>
                                                    <code class="structure-signature">@declaration.Signature</code>
                                                    @if (!string.IsNullOrEmpty(declaration.Namespace))
                                                    {
                                                        <span class="structure-namespace">namespace @declaration.Namespace</span>
                                                    }
                                                </li>
                                            }
                                        </ol>
                                    }
                                    @if (entry.StructureIsTruncated)
                                    {
                                        <p class="structure-note">The scan reached a configured safety limit; results may be incomplete.</p>
                                    }
                                    @if ((entry.StructureSyntaxErrorFiles ?? 0) > 0)
                                    {
                                        <p class="structure-note">@entry.StructureSyntaxErrorFiles source files contained syntax errors; declarations shown are based on Roslyn's recovered syntax.</p>
                                    }
                                    <p class="structure-footnote">Syntax-based declaration discovery only. It does not yet compile the project or resolve symbol references.</p>
                                </section>
                            }
                        </article>
                    </li>
                }

                @if (Session.IsSubmitting)
                {
                    <li id="pending-turn" class="chat-exchange pending-exchange" data-turn-state="processing">
                        @if (!string.IsNullOrEmpty(Session.PendingRequestText))
                        {
                            <article class="chat-message user-message" data-message-role="user" aria-label="Your message">
                                <div class="message-header">
                                    <span class="message-author">You</span>
                                </div>
                                <p class="message-body user-body">@Session.PendingRequestText</p>
                            </article>
                        }

                        <article
                            class="chat-message assistant-message assistant-pending"
                            data-message-role="assistant"
                            role="status"
                            aria-label="Lattice is checking the workspace">
                            <div class="message-header">
                                <span class="message-author">Lattice</span>
                            </div>
                            <p class="message-body pending-text">
                                <span class="pending-dots" aria-hidden="true">
                                    <span></span><span></span><span></span>
                                </span>
                                Checking the workspace…
                            </p>
                        </article>
                    </li>
                }
            </ol>
        }
    </section>

    <footer class="composer-region">
        @if (Session.RequestError is not null)
        {
            <p id="composer-error" class="alert error composer-alert" role="alert">@Session.RequestError</p>
        }

        <form id="chat-form" class="composer-form" @onsubmit="SubmitComposerAsync" @onsubmit:preventDefault>
            <fieldset disabled="@Session.IsBusy" class="composer-fieldset">
                <label for="message-input" class="sr-only">Message Lattice</label>
                <div class="composer-surface">
                    <textarea
                        id="message-input"
                        @ref="_composerElement"
                        rows="2"
                        @bind="Session.MessageInput"
                        @bind:event="oninput"
                        @onkeydown="HandleComposerKeyDownAsync"
                        placeholder="Ask about files, C# types, members, or where an identifier is used…"
                        aria-describedby="composer-hint"></textarea>
                    <button id="send-message" type="submit" class="primary send-button">
                        @(Session.IsSubmitting ? "Sending…" : "Send")
                    </button>
                </div>
                <p id="composer-hint" class="composer-hint">
                    <kbd>Enter</kbd> to send · <kbd>Shift</kbd>+<kbd>Enter</kbd> for a new line · Read-only workspace · Literal text search · C# syntax structure (not semantic resolution)
                </p>
            </fieldset>
        </form>
    </footer>
</main>

@code {
    private ElementReference _composerElement;
    private bool _restoreComposerFocus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restoreComposerFocus && !Session.IsBusy)
        {
            _restoreComposerFocus = false;
            try
            {
                await _composerElement.FocusAsync();
            }
            catch (Exception)
            {
                // Ignore focus failures when running detached or shutting down.
            }
        }
    }

    private async Task HandleComposerKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter"
            && !args.ShiftKey
            && !args.CtrlKey
            && !args.AltKey
            && !args.MetaKey
            && !Session.IsBusy)
        {
            await SubmitComposerAsync();
        }
    }

    private async Task SubmitComposerAsync()
    {
        int priorCount = Session.Entries.Count;
        await Session.SendMessageAsync();
        if (Session.Entries.Count > priorCount)
        {
            _restoreComposerFocus = true;
        }
    }

    private static string GetExchangeClass(DesktopTurnKind kind) => kind switch
    {
        DesktopTurnKind.FileInspected or DesktopTurnKind.SearchResults or DesktopTurnKind.CSharpStructureResults => "exchange-ok",
        DesktopTurnKind.NoMatches => "exchange-neutral",
        DesktopTurnKind.AmbiguousInput or DesktopTurnKind.UnsupportedInput => "exchange-clarification",
        _ => "exchange-error",
    };

    private static string GetAssistantClass(DesktopTurnKind kind) => kind switch
    {
        DesktopTurnKind.FileInspected or DesktopTurnKind.SearchResults or DesktopTurnKind.CSharpStructureResults => "assistant-ok",
        DesktopTurnKind.NoMatches => "assistant-neutral",
        DesktopTurnKind.AmbiguousInput or DesktopTurnKind.UnsupportedInput => "assistant-clarification",
        _ => "assistant-error",
    };

    private static string FormatLines(int? lineCount) => lineCount switch
    {
        null => string.Empty,
        1 => "1 line",
        int count => $"{count} lines",
    };

    private static string FormatOmittedCandidates(int omittedCount, bool hasMoreCandidates)
    {
        if (hasMoreCandidates)
        {
            return omittedCount > 0
                ? $"At least {omittedCount} additional matching files omitted — specify a folder path to narrow down."
                : "Additional matching files omitted — specify a folder path to narrow down.";
        }

        return omittedCount == 1
            ? "1 additional matching file omitted."
            : $"{omittedCount} additional matching files omitted.";
    }
}
